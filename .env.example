# PostgreSQL connection string (via PgBouncer connection pooling)
DATABASE_URL="postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# Direct connection string (used by Prisma Migrate)
DIRECT_URL="postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secret untuk menandatangani JWT. Gunakan nilai acak panjang di environment produksi.
JWT_SECRET="replace-with-a-long-random-secret"
